BIMFM_SESSION_SECRET=replace-with-a-long-random-secret
BIMFM_COOKIE_HTTPS_ONLY=false
BIMFM_HR_DATABASE=./data/hr.db
BIMFM_BOOTSTRAP_ADMIN_USERNAME=admin
BIMFM_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BIMFM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Production hardening
BIMFM_ENV=development
BIMFM_LOG_LEVEL=INFO
BIMFM_API_RATE_LIMIT_PER_MINUTE=120
BIMFM_LOGIN_RATE_LIMIT_PER_MINUTE=20
BIMFM_TRUST_PROXY_HEADERS=false

# Optional outbound email for task reminders. In-app reminders work without this.
BIMFM_SMTP_HOST=
BIMFM_SMTP_PORT=587
BIMFM_SMTP_USERNAME=
BIMFM_SMTP_PASSWORD=
BIMFM_SMTP_FROM_EMAIL=
BIMFM_SMTP_USE_TLS=true
