+def _is_assignment_scoped(principal: Principal) -> bool:
+    """Return whether project API access must be limited to assignments."""
+    return principal.kind == "employee" or principal.role == Role.EMPLOYEE
+
+
+def _employee_assignment_ids(database: Session, principal: Principal) -> tuple[int, ...]:
+    """Return every project-side identity mapped to the signed-in freelancer.
+
+    Management roles keep their existing organization-wide visibility. Employee
+    access fails closed when the account has no freelancer mapping, including a
+    staff account that was accidentally assigned the EMPLOYEE role.
+    """
+    if not _is_assignment_scoped(principal):
+        return ()
+    freelancer_id = _freelancer_id(principal)
+    if freelancer_id is None:
+        return ()
+    return tuple(sorted(resolved_assignment_ids(database, freelancer_id=freelancer_id)))
+
+
+def _employee_project_scope(database: Session, principal: Principal):
+    """SQL condition limiting employees to assigned projects only."""
+    if not _is_assignment_scoped(principal):
+        return None
+    assignment_ids = _employee_assignment_ids(database, principal)
+    if not assignment_ids:
+        return false()
+    active_membership = exists(
+        select(PortalProjectMember.id).where(
+            PortalProjectMember.project_id == PortalProject.id,
+            PortalProjectMember.freelancer_id.in_(assignment_ids),
+            PortalProjectMember.is_active.is_(True),
+        )
+    )
+    assigned_task = exists(
+        select(PortalTaskAssignment.id)
+        .join(PortalTask, PortalTask.id == PortalTaskAssignment.task_id)
+        .where(
+            PortalTask.project_id == PortalProject.id,
+            PortalTaskAssignment.freelancer_id.in_(assignment_ids),
+        )
+    )
+    return or_(active_membership, assigned_task)
+
+
+def _employee_task_scope(database: Session, principal: Principal):
+    """SQL condition limiting employees to tasks assigned to their identities."""
+    if not _is_assignment_scoped(principal):
+        return None
+    assignment_ids = _employee_assignment_ids(database, principal)
+    if not assignment_ids:
+        return false()
+    return exists(
+        select(PortalTaskAssignment.id).where(
+            PortalTaskAssignment.task_id == PortalTask.id,
+            PortalTaskAssignment.freelancer_id.in_(assignment_ids),
+        )
+    )
+
